---
import Link from '@/components/Link.astro'
import { Badge } from '@/components/ui/badge'
import { AUTHOR_NAME_VARIANTS } from '@/consts'
import type { Paper } from '@/types'

interface Props {
  paper: Paper
  // Shown next to the title, e.g. "Under Review"
  status?: string
}

const { paper, status } = Astro.props

const ownNames = AUTHOR_NAME_VARIANTS.map((name) => name.toLowerCase())
const isOwnName = (author: string) =>
  ownNames.includes(author.trim().toLowerCase())

const LINK_LABELS: [keyof NonNullable<Paper['links']>, string][] = [
  ['doi', 'DOI'],
  ['pdf', 'PDF'],
  ['arxiv', 'arXiv'],
  ['code', 'Code'],
  ['website', 'Website'],
]
const links = LINK_LABELS.flatMap(([key, label]) => {
  const href = paper.links?.[key]
  return href ? [{ href, label }] : []
})
---

<li class="bg-muted/30 flex flex-col gap-y-1.5 rounded-md border p-4">
  <div class="flex flex-col gap-y-0.5">
    {
      status ? (
        <div class="flex items-start justify-between gap-2">
          <h3 class="flex-1 text-base leading-tight font-semibold">
            {paper.title}
          </h3>
          <Badge variant="muted" className="shrink-0 text-xs">
            {status}
          </Badge>
        </div>
      ) : (
        <h3 class="text-base leading-tight font-semibold">{paper.title}</h3>
      )
    }
    <p class="text-muted-foreground text-xs leading-tight">
      {paper.authors.map((author, i) => <>{i > 0 && ', '}{isOwnName(author) ? <strong class="text-primary font-semibold">{author}</strong> : author}</>)}
    </p>
    <p class="text-muted-foreground text-xs">
      {paper.venue && <span class="font-medium">{paper.venue}</span>}
      {paper.venue && paper.year && ' • '}
      {paper.year}
    </p>
  </div>
  {
    paper.abstract && (
      <details data-animate-open class="group/abstract mt-2">
        <summary class="border-primary/45 bg-primary/5 text-foreground hover:bg-primary/10 hover:border-primary/60 focus-visible:ring-ring inline-flex w-fit max-w-full cursor-pointer list-none items-center gap-2 rounded-md border px-3 py-1.5 text-left text-xs font-medium shadow-sm transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none [&::-webkit-details-marker]:hidden">
          <span
            class="text-primary inline-block text-[10px] leading-none transition-transform group-open/abstract:-rotate-180"
            aria-hidden="true"
          >
            ▼
          </span>
          <span class="shrink-0">Abstract</span>
          <span class="text-muted-foreground text-[11px] font-normal">
            (click to expand)
          </span>
        </summary>
        <p class="text-muted-foreground border-primary/40 mt-2 border-l-2 pl-3 text-xs leading-relaxed">
          {paper.abstract}
        </p>
      </details>
    )
  }
  {
    paper.links && (
      <div class="mt-1 flex flex-wrap gap-1.5">
        {links.map(({ href, label }) => (
          <Link
            href={href}
            class="bg-muted text-foreground hover:bg-muted/90 inline-flex items-center rounded-md border px-2 py-0.5 text-[11px] font-medium transition-colors"
            external
          >
            {label}
          </Link>
        ))}
      </div>
    )
  }
</li>
