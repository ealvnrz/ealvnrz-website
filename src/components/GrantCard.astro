---
import { Badge } from '@/components/ui/badge'
import type { Grant } from '@/types'

interface Props {
  grant: Grant
}

const { grant } = Astro.props

const STATUS_BADGES: Partial<
  Record<Grant['status'], { label: string; variant: 'default' | 'muted' }>
> = {
  active: { label: 'Active', variant: 'default' },
  pending: { label: 'Pending', variant: 'muted' },
}
const badge = STATUS_BADGES[grant.status]

const LINK_LABELS: [keyof NonNullable<Grant['links']>, string][] = [
  ['website', 'Website'],
  ['report', 'Report'],
]
const links = LINK_LABELS.flatMap(([key, label]) => {
  const href = grant.links?.[key]
  return href ? [{ href, label }] : []
})
---

<li class="bg-muted/30 flex flex-col gap-y-1.5 rounded-md border p-4">
  <div class="flex flex-col gap-y-0.5">
    {
      badge ? (
        <div class="flex items-start justify-between gap-2">
          <h3 class="flex-1 text-base leading-tight font-semibold">
            {grant.title}
          </h3>
          <Badge variant={badge.variant} className="shrink-0 text-xs">
            {badge.label}
          </Badge>
        </div>
      ) : (
        <h3 class="text-base leading-tight font-semibold">{grant.title}</h3>
      )
    }
    <p class="text-muted-foreground text-xs">
      <span class="font-medium">{grant.agency}</span>
      {' • '}
      {grant.period}
    </p>
    <p class="text-muted-foreground text-xs">
      Role: <span class="font-medium">{grant.role}</span>
    </p>
  </div>
  {
    grant.description && (
      <p class="text-muted-foreground mt-1 text-xs">{grant.description}</p>
    )
  }
  {
    grant.links && (
      <div class="mt-1 flex flex-wrap gap-1.5">
        {links.map(({ href, label }) => (
          <a
            href={href}
            class="text-muted-foreground hover:text-foreground text-xs underline"
            target="_blank"
            rel="noopener noreferrer"
          >
            {label}
          </a>
        ))}
      </div>
    )
  }
</li>
