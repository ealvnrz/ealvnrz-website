---
import CollapsibleSection from '@/components/CollapsibleSection.astro'
import PageHead from '@/components/PageHead.astro'
import PaperCard from '@/components/PaperCard.astro'
import publicationsData from '@/data/publications.json'
import Layout from '@/layouts/Layout.astro'
import type { Paper } from '@/types'

const papers: Paper[] = (publicationsData.papers as Paper[]).sort((a, b) => {
  // Handle string years (like "forthcoming") - put them at the top
  if (typeof a.year === 'string' && typeof b.year === 'string') {
    // Both are strings, keep original order
    return 0
  }
  if (typeof a.year === 'string') {
    // a is "forthcoming", put it first
    return -1
  }
  if (typeof b.year === 'string') {
    // b is "forthcoming", put it first
    return 1
  }
  // Handle null years
  if (!a.year && !b.year) return 0
  if (!a.year) return 1
  if (!b.year) return -1
  // Both are numbers, sort descending; tie-break by publishedDate when available
  if (typeof a.year === 'number' && typeof b.year === 'number') {
    if (b.year !== a.year) return b.year - a.year
    const aDate = a.publishedDate ? new Date(a.publishedDate).getTime() : 0
    const bDate = b.publishedDate ? new Date(b.publishedDate).getTime() : 0
    return bDate - aDate
  }
  return 0
})
const underReview: Paper[] = ((publicationsData.underReview || []) as Paper[]).sort((a, b) => {
  // Handle null years by putting them at the end
  if (!a.year && !b.year) return 0
  if (!a.year) return 1
  if (!b.year) return -1
  // Handle string years
  if (typeof a.year === 'string' || typeof b.year === 'string') return 0
  // Both are numbers, sort descending
  if (typeof a.year === 'number' && typeof b.year === 'number') {
    return b.year - a.year
  }
  return 0
})
---

<Layout class="max-w-5xl">
  <PageHead slot="head" title="Publications" />
  <section class="flex flex-col gap-y-6">
    <div>
      <h1 class="text-4xl font-bold mb-2">Publications</h1>
      <p class="text-muted-foreground">
        A list of my academic publications and research papers.
      </p>
    </div>

    {underReview.length > 0 && (
      <CollapsibleSection title="Submitted/Under Review">
        {underReview.map((paper) => (
          <PaperCard paper={paper} status={paper.status ?? 'Under Review'} />
        ))}
      </CollapsibleSection>
    )}

    {papers.length > 0 && (
      <CollapsibleSection title="Accepted/Published">
        {papers.map((paper) => <PaperCard paper={paper} />)}
      </CollapsibleSection>
    )}
  </section>
</Layout>
