---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import { BLOG_ENABLED, SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getAllProjects } from '@/lib/data-utils'

// An empty response makes the static build skip this page
if (!BLOG_ENABLED) return new Response(null, { status: 404 })

const projects = await getAllProjects()
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="About" />
  <Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />

  <section>
    <div class="min-w-full">
      <div class="prose mb-8">
        <p class="mt-0">{SITE.description}</p>
      </div>

      {
        projects.length > 0 && (
          <>
            <h2 class="mb-4 text-2xl font-medium">Projects</h2>
            <div class="flex flex-col gap-4">
              {projects.map((project) => (
                <ProjectCard project={project} />
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>
</Layout>
